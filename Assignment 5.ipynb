   "source": [
    "import re\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "if re.fullmatch(r'[a-zA-Z0-9]+', string):\n",
    "    print(\"String contains only allowed characters.\")\n",
    "else:\n",
    "    print(\"String contains invalid characters.\")"
   ]
